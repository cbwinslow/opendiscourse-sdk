    print(f"   Overall Status: {health['overall_status'].upper()}")

    print("\n📈 Collecting baseline metrics...")
    metrics = monitor.collect_metrics()
    print(f"   Records/Minute: {metrics.performance['records_processed_per_minute']}")
    print(f"   Error Rate: {metrics.error_rates['total_error_rate_percent']:.2f}%")

    print("\n🚨 Checking alert conditions...")
    alerts = monitor.check_alerts()
    print(f"   Active Alerts: {len(alerts)}")

    # Generate comprehensive report
    print("\n" + "=" * 80)
    print("📋 GENERATING COMPREHENSIVE MONITORING REPORT")
    print("=" * 80)

    report = monitor.generate_monitoring_report()
    print(report)

    # Save report
    if monitor.save_monitoring_report():
        print("\n✅ Production monitoring report saved successfully!")
        print("📄 Location: tests/monitoring/production_monitoring_report.txt")
    else:
        print("\n❌ Failed to save monitoring report")

    # Final status summary
    overall_status = health['overall_status']
    print("\n" + "=" * 80)
    print("🎯 PRODUCTION SYSTEM STATUS SUMMARY")
    print("=" * 80)

    if overall_status == SystemStatus.HEALTHY.value:
        print("✅ PRODUCTION READY: All systems operating normally")
        print("🎯 Ready for high-volume ingestion operations")
    elif overall_status == SystemStatus.DEGRADED.value:
        print("⚠️  PRODUCTION DEGRADED: Minor issues detected")
        print("🔧 Recommend addressing issues before full production load")
    else:
        print("🚨 PRODUCTION CRITICAL: Immediate attention required")
        print("🛑 Not ready for production operations")

    print(f"\n📊 Current Status: {overall_status.upper()}")
    print(f"🚨 Active Alerts: {len(alerts)}")
    print(f"📈 Performance: {metrics.performance['records_processed_per_minute']} records/min")
    print(f"❌ Error Rate: {metrics.error_rates['total_error_rate_percent']:.2f}%")

    # Offer to start continuous monitoring
    print(f"\n💡 TIP: Run with --continuous for ongoing monitoring")
    print("   Example: python tests/monitoring/production_monitor.py --continuous")

    return overall_status == SystemStatus.HEALTHY.value

