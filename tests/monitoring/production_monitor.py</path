    def check_alerts(self) -> List[Alert]:
        """Check for alert conditions and generate alerts"""
        alerts = []
        health = self.monitoring_data.get('system_health', {})
        metrics = self.monitoring_data.get('metrics', [])

        if not metrics:
            return alerts

        latest_metrics = metrics[-1] if isinstance(metrics[-1], dict) else asdict(metrics[-1])

        # Check error rate alerts
        error_rate = latest_metrics.get('error_rates', {}).get('total_error_rate_percent', 0)
        if error_rate > self.config['thresholds']['error_rate_critical']:
            alert = Alert(
                id=f"error_rate_critical_{int(time.time())}",
                level=AlertLevel.CRITICAL,
                message=f'Critical error rate detected: {error_rate:.2f}%',
                component='performance',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        elif error_rate > self.config['thresholds']['error_rate_warning']:
            alert = Alert(
                id=f"error_rate_warning_{int(time.time())}",
                level=AlertLevel.WARNING,
                message=f'Elevated error rate: {error_rate:.2f}%',
                component='performance',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        # Check API response time alerts
        api_time = latest_metrics.get('performance', {}).get('api_response_time_ms', 0)
        if api_time > self.config['thresholds']['response_time_critical']:
            alert = Alert(
                id=f"api_response_critical_{int(time.time())}",
                level=AlertLevel.CRITICAL,
                message=f'Critical API response time: {api_time}ms',
                component='api',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        elif api_time > self.config['thresholds']['response_time_warning']:
            alert = Alert(
                id=f"api_response_warning_{int(time.time())}",
                level=AlertLevel.WARNING,
                message=f'Slow API response time: {api_time}ms',
                component='api',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        # Check resource usage alerts
        resource_usage = latest_metrics.get('resource_usage', {})
        cpu_usage = resource_usage.get('cpu_usage_percent', 0)
        memory_usage = resource_usage.get('memory_usage_percent', 0)

        if cpu_usage > self.config['thresholds']['cpu_usage_critical']:
            alert = Alert(
                id=f"cpu_critical_{int(time.time())}",
                level=AlertLevel.CRITICAL,
                message=f'Critical CPU usage: {cpu_usage:.1f}%',
                component='system',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        if memory_usage > self.config['thresholds']['memory_usage_critical']:
            alert = Alert(
                id=f"memory_critical_{int(time.time())}",
                level=AlertLevel.CRITICAL,
                message=f'Critical memory usage: {memory_usage:.1f}%',
                component='system',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        # Check ingestion health alerts
        components = health.get('components', {})
        ingestion_health = components.get('ingestion_process', {})
        if ingestion_health.get('status') == 'unhealthy':
            alert = Alert(
                id=f"ingestion_unhealthy_{int(time.time())}",
                level=AlertLevel.CRITICAL,
                message='Ingestion process is unhealthy',
                component='ingestion',
                timestamp=datetime.now().isoformat()
            )
            alerts.append(alert)

        # Store alerts and send notifications
        for alert in alerts:
            self._store_alert(alert)
            self._send_alert_notification(alert)

        self.monitoring_data['alerts'].extend([asdict(alert) for alert in alerts])
        return alerts

    def _store_metrics(self, metrics: MetricSnapshot):
        """Store metrics in database"""
        try:
            with sqlite3.connect(self.db_path) as conn:
                conn.execute('''
                    INSERT INTO metrics (timestamp, performance, resource_usage, error_rates, status)
                    VALUES (?, ?, ?, ?, ?)
                ''', (
                    metrics.timestamp,
                    json.dumps(metrics.performance),
                    json.dumps(metrics.resource_usage),
                    json.dumps(metrics.error_rates),
                    metrics.status
                ))
        except Exception as e:
            logger.error(f"Failed to store metrics: {str(e)}")

    def _store_alert(self, alert: Alert):
        """Store alert in database"""
        try:
            with sqlite3.connect(self.db_path) as conn:
                conn.execute('''
                    INSERT INTO alerts (alert_id, level, message, component, timestamp, resolved)
                    VALUES (?, ?, ?, ?, ?, ?)
                ''', (
                    alert.id,
                    alert.level.value,
                    alert.message,
                    alert.component,
                    alert.timestamp,
                    1 if alert.resolved else 0
                ))
        except Exception as e:
            logger.error(f"Failed to store alert: {str(e)}")

    def _store_health_status(self, health_status: Dict[str, Any]):
        """Store health status in database"""
        try:
            with sqlite3.connect(self.db_path) as conn:
                conn.execute('''
                    INSERT INTO system_health (timestamp, overall_status, components)
                    VALUES (?, ?, ?)
                ''', (
                    health_status['last_check'],
                    health_status['overall_status'],
                    json.dumps(health_status['components'])
                ))
        except Exception as e:
            logger.error(f"Failed to store health status: {str(e)}")

