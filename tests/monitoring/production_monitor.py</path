            logger.info(f"Monitoring report saved to: {filepath}")
            return True
        except Exception as e:
            logger.error(f"Failed to save monitoring report: {str(e)}")
            return False

    def start_monitoring_loop(self, interval_seconds: int = 60, duration_minutes: int = 60):
        """Start continuous monitoring loop"""
        logger.info(f"Starting monitoring loop: {interval_seconds}s interval for {duration_minutes} minutes")

        end_time = datetime.now() + timedelta(minutes=duration_minutes)

        while datetime.now() < end_time:
            try:
                # Collect health and metrics
                health = self.check_system_health()
                metrics = self.collect_metrics()
                alerts = self.check_alerts()

                # Log status
                logger.info(f"System status: {health['overall_status']} | "
                           f"Records/min: {metrics.performance['records_processed_per_minute']} | "
                           f"Error rate: {metrics.error_rates['total_error_rate_percent']:.2f}% | "
                           f"Alerts: {len(alerts)}")

                # Wait for next interval
                time.sleep(interval_seconds)

            except KeyboardInterrupt:
                logger.info("Monitoring loop interrupted by user")
                break
            except Exception as e:
                logger.error(f"Error in monitoring loop: {str(e)}")
                time.sleep(interval_seconds)

        logger.info("Monitoring loop completed")

