    def check_system_health(self) -> Dict[str, Any]:
        """Comprehensive system health check"""
        health_status = {
            'overall_status': SystemStatus.HEALTHY.value,
            'components': {
                'database': self._check_database_health(),
                'api_congress_gov': self._check_api_health('congress_gov'),
                'api_openstates': self._check_api_health('openstates'),
                'api_govinfo': self._check_api_health('govinfo'),
                'ingestion_process': self._check_ingestion_health(),
                'disk_space': self._check_disk_space(),
                'memory_usage': self._check_memory_usage(),
                'cpu_usage': self._check_cpu_usage()
            },
            'last_check': datetime.now().isoformat(),
            'uptime_hours': 0,
            'total_records_processed': 0
        }

        # Determine overall health
        unhealthy_components = [
            component for component, status in health_status['components'].items()
            if isinstance(status, dict) and status.get('status') == 'unhealthy'
        ]

        degraded_components = [
            component for component, status in health_status['components'].items()
            if isinstance(status, dict) and status.get('status') == 'degraded'
        ]

        if len(unhealthy_components) > 2:
            health_status['overall_status'] = SystemStatus.CRITICAL.value
        elif len(unhealthy_components) > 0 or len(degraded_components) > 1:
            health_status['overall_status'] = SystemStatus.DEGRADED.value
        else:
            health_status['overall_status'] = SystemStatus.HEALTHY.value

        # Store health status in database
        self._store_health_status(health_status)
        self.monitoring_data['system_health'] = health_status
        return health_status

    def _check_database_health(self) -> Dict[str, Any]:
        """Check database connectivity and performance"""
        try:
            # Simulate database health check
            start_time = time.time()
            time.sleep(0.01)  # Simulate quick query
            response_time = (time.time() - start_time) * 1000

            return {
                'status': 'healthy',
                'response_time_ms': response_time,
                'connections_active': 5,
                'query_rate_per_minute': 100
            }
        except Exception as e:
            return {
                'status': 'unhealthy',
                'error': str(e),
                'response_time_ms': 0
            }

    def _check_api_health(self, api_name: str) -> Dict[str, Any]:
