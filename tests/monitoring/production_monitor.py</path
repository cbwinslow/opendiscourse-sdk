    def _get_recent_metrics(self, hours: int = 24) -> List[Dict[str, Any]]:
        """Get recent metrics from database"""
        try:
            with sqlite3.connect(self.db_path) as conn:
                since = (datetime.now() - timedelta(hours=hours)).isoformat()
                cursor = conn.execute('''
                    SELECT timestamp, performance, resource_usage, error_rates, status
                    FROM metrics WHERE timestamp > ?
                    ORDER BY timestamp DESC
                ''', (since,))

                metrics = []
                for row in cursor.fetchall():
                    metrics.append({
                        'timestamp': row[0],
                        'performance': json.loads(row[1]),
                        'resource_usage': json.loads(row[2]),
                        'error_rates': json.loads(row[3]),
                        'status': row[4]
                    })
                return metrics
        except Exception as e:
            logger.error(f"Failed to get recent metrics: {str(e)}")
            return []

