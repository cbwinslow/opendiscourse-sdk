    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger(__name__)

class AlertLevel(Enum):
    """Alert severity levels"""
    INFO = "info"
    WARNING = "warning"
    CRITICAL = "critical"

class SystemStatus(Enum):
    """System health status"""
    HEALTHY = "healthy"
    DEGRADED = "degraded"
    CRITICAL = "critical"

@dataclass
class MetricSnapshot:
    """Metrics snapshot for tracking"""
    timestamp: str
    performance: Dict[str, float]
    resource_usage: Dict[str, float]
    error_rates: Dict[str, float]
    status: str

@dataclass
class Alert:
    """Alert object"""
    id: str
    level: AlertLevel
    message: str
    component: str
    timestamp: str
    resolved: bool = False

class ProductionMonitor:
    """Production monitoring system for ingestion pipeline"""

    def __init__(self, config_path: str = "config/environments/production.toml"):
        self.config_path = config_path
        self.monitoring_data = {
            'timestamp': datetime.now().isoformat(),
            'system_health': {},
            'alerts': [],
            'metrics': [],
            'checkpoints': {}
        }
        self.alert_history = []
        self.db_path = "tests/monitoring/monitoring.db"
        self._init_database()
        self._load_config()

    def _init_database(self):
        """Initialize monitoring database"""
        try:
            os.makedirs(os.path.dirname(self.db_path), exist_ok=True)
            with sqlite3.connect(self.db_path) as conn:
                conn.execute('''
                    CREATE TABLE IF NOT EXISTS metrics (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp TEXT NOT NULL,
                        performance TEXT NOT NULL,
                        resource_usage TEXT NOT NULL,
                        error_rates TEXT NOT NULL,
                        status TEXT NOT NULL
                    )
                ''')

                conn.execute('''
                    CREATE TABLE IF NOT EXISTS alerts (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        alert_id TEXT NOT NULL,
                        level TEXT NOT NULL,
                        message TEXT NOT NULL,
                        component TEXT NOT NULL,
                        timestamp TEXT NOT NULL,
                        resolved INTEGER DEFAULT 0
                    )
                ''')

                conn.execute('''
                    CREATE TABLE IF NOT EXISTS system_health (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        timestamp TEXT NOT NULL,
                        overall_status TEXT NOT NULL,
                        components TEXT NOT NULL
                    )
                ''')
        except Exception as e:
            logger.error(f"Failed to initialize monitoring database: {str(e)}")

