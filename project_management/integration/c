@dataclass
class IssueMapping:
    """Standard issue data structure for cross-platform mapping"""
    platform_id: str
    platform: str
    title: str
    description: str
    status: str
    priority: str
    labels: List[str]
    assignee: str
    created_at: str
    updated_at: str
    url: str
    epic_id: Optional[str] = None
    estimate: Optional[int] = None
    story_points: Optional[int] = None

class PlatformAPI(ABC):
    """Abstract base class for platform APIs"""

    @abstractmethod
    async def create_issue(self, issue_data: IssueMapping) -> Dict:
        pass

    @abstractmethod
    async def update_issue(self, issue_id: str, issue_data: Dict) -> Dict:
        pass

    @abstractmethod
    async def get_issue(self, issue_id: str) -> Dict:
        pass

    @abstractmethod
    async def list_issues(self, filters: Dict = None) -> List[Dict]:
        pass

    @abstractmethod
    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        pass

class GitHubAPI(PlatformAPI):
    """GitHub API implementation"""

    def __init__(self):
        self.token = os.getenv('GITHUB_TOKEN')
        self.repo = "cbwinslow/opendiscourse"
        self.base_url = "https://api.github.com"
        self.headers = {
            "Authorization": f"token {self.token}",
            "Accept": "application/vnd.github.v3+json",
            "Content-Type": "application/json"
        }

    async def create_issue(self, issue_data: IssueMapping) -> Dict:
        """Create GitHub issue"""
        data = {
            "title": issue_data.title,
            "body": issue_data.description,
            "labels": issue_data.labels,
            "assignees": [issue_data.assignee] if issue_data.assignee else []
        }

        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{self.base_url}/repos/{self.repo}/issues",
                headers=self.headers,
                json=data
            ) as response:
                if response.status == 201:
                    result = await response.json()
                    logger.info(f"Created GitHub issue: {result['number']}")
                    return result
                else:
                    error_text = await response.text()
                    logger.error(f"Failed to create GitHub issue: {error_text}")
                    raise Exception(f"GitHub API error: {response.status}")

    async def update_issue(self, issue_id: str, issue_data: Dict) -> Dict:
        """Update GitHub issue"""
        async with aiohttp.ClientSession() as session:
            async with session.patch(
                f"{self.base_url}/repos/{self.repo}/issues/{issue_id}",
                headers=self.headers,
                json=issue_data
            ) as response:
                if response.status == 200:
                    result = await response.json()
                    logger.info(f"Updated GitHub issue: {issue_id}")
                    return result
                else:
                    error_text = await response.text()
                    logger.error(f"Failed to update GitHub issue: {error_text}")
                    raise Exception(f"GitHub API error: {response.status}")

    async def get_issue(self, issue_id: str) -> Dict:
        """Get GitHub issue"""
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{self.base_url}/repos/{self.repo}/issues/{issue_id}",
                headers=self.headers
            ) as response:
                if response.status == 200:
                    return await response.json()
                else:
                    logger.error(f"Failed to get GitHub issue {issue_id}: {response.status}")
                    raise Exception(f"GitHub API error: {response.status}")

    async def list_issues(self, filters: Dict = None) -> List[Dict]:
        """List GitHub issues"""
        params = filters or {}
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{self.base_url}/repos/{self.repo}/issues",
                headers=self.headers,
                params=params
            ) as response:
                if response.status == 200:
                    return await response.json()
                else:
                    logger.error(f"Failed to list GitHub issues: {response.status}")
                    return []

    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        """Sync issue status"""
        # Map generic status to GitHub states
        status_mapping = {
            "open": "open",
            "in_progress": "open",
            "in_review": "open",
            "testing": "open",
            "done": "closed",
            "blocked": "open"
        }

        gh_status = status_mapping.get(new_status.lower(), "open")
        state_data = {"state": gh_status}

        try:
            await self.update_issue(issue_id, state_data)
            return True
        except Exception as e:
            logger.error(f"Failed to sync status for issue {issue_id}: {e}")
            return False

class LinearAPI(PlatformAPI):
    """Linear API implementation"""

    def __init__(self):
        self.token = os.getenv('LINEAR_API_KEY')
        self.base_url = "https://api.linear.app/graphql"
        self.headers = {
            "Authorization": f"Bearer {self.token}",
            "Content-Type": "application/json"
        }

    async def _execute_graphql(self, query: str, variables: Dict = None) -> Dict:
        """Execute GraphQL query"""
        payload = {
            "query": query,
            "variables": variables or {}
        }

        async with aiohttp.ClientSession() as session:
            async with session.post(
                self.base_url,
                headers=self.headers,
                json=payload
            ) as response:
                if response.status == 200:
                    result = await response.json()
                    if result.get("errors"):
                        logger.error(f"GraphQL errors: {result['errors']}")
                        raise Exception(f"Linear GraphQL error: {result['errors']}")
                    return result
                else:
                    error_text = await response.text()
                    logger.error(f"Linear API error: {error_text}")
                    raise Exception(f"Linear API error: {response.status}")

    async def create_issue(self, issue_data: IssueMapping) -> Dict:
        """Create Linear issue"""
        mutation = """
        mutation IssueCreate($input: IssueCreateInput!) {
            issueCreate(input: $input) {
                success
                issue {
                    id
                    identifier
                    title
                    url
                }
            }
        }
        """

        variables = {
            "input": {
                "title": issue_data.title,
                "description": issue_data.description,
                "teamId": "opendiscourse-core",  # Replace with actual team ID
                "priority": self._map_priority(issue_data.priority)
            }
        }

        result = await self._execute_graphql(mutation, variables)
        issue_info = result["data"]["issueCreate"]["issue"]
        logger.info(f"Created Linear issue: {issue_info['identifier']}")
        return issue_info

    async def update_issue(self, issue_id: str, issue_data: Dict) -> Dict:
        """Update Linear issue"""
        mutation = """
        mutation IssueUpdate($id: String!, $input: IssueUpdateInput!) {
            issueUpdate(id: $id, input: $input) {
                success
                issue {
                    id
                    title
                    url
                }
            }
        }
        """

        variables = {
            "id": issue_id,
            "input": issue_data
        }

        result = await self._execute_graphql(mutation, variables)
        logger.info(f"Updated Linear issue: {issue_id}")
        return result["data"]["issueUpdate"]["issue"]

    async def get_issue(self, issue_id: str) -> Dict:
        """Get Linear issue"""
        query = """
        query Issue($id: String!) {
            issue(id: $id) {
                id
                identifier
                title
                description
                state {
                    name
                }
                priority
                assignee {
                    name
                }
                labels {
                    nodes {
                        name
                    }
                }
                url
            }
        }
        """

        variables = {"id": issue_id}
        result = await self._execute_graphql(query, variables)
        return result["data"]["issue"]

    async def list_issues(self, filters: Dict = None) -> List[Dict]:
        """List Linear issues"""
        query = """
        query Issues($filter: IssueFilter) {
            issues(filter: $filter) {
                nodes {
                    id
                    identifier
                    title
                    state {
                        name
                    }
                    priority
                    assignee {
                        name
                    }
                    labels {
                        nodes {
                            name
                        }
                    }
                    url
                }
            }
        }
        """

        variables = {"filter": filters or {}}
        result = await self._execute_graphql(query, variables)
        return result["data"]["issues"]["nodes"]

    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        """Sync issue status"""
        # Map generic status to Linear states
        status_mapping = {
            "open": "Todo",
            "in_progress": "In Progress",
            "in_review": "In Review",
            "testing": "In Review",
            "done": "Done",
            "blocked": "Backlog"
        }

        linear_state = status_mapping.get(new_status.lower(), "Backlog")

        mutation = """
        mutation IssueUpdate($id: String!, $input: IssueUpdateInput!) {
            issueUpdate(id: $id, input: $input) {
                success
            }
        }
        """

        variables = {
            "id": issue_id,
            "input": {"state": linear_state}
        }

        try:
            await self._execute_graphql(mutation, variables)
            return True
        except Exception as e:
            logger.error(f"Failed to sync Linear status: {e}")
            return False

    def _map_priority(self, priority: str) -> int:
        """Map priority string to Linear priority number"""
        mapping = {
            "low": 4,
            "medium": 3,
            "high": 2,
            "critical": 1
        }
        return mapping.get(priority.lower(), 3)

