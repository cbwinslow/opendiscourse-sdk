                f"{self.base_url}/projects/{self.project_id}/issues",
                headers=self.headers,
                params=params
            ) as response:
                if response.status == 200:
                    return await response.json()
                else:
                    logger.error(f"Failed to list GitLab issues: {response.status}")
                    return []

    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        """Sync issue status"""
        # Map generic status to GitLab states
        status_mapping = {
            "open": "opened",
            "in_progress": "opened",
            "in_review": "opened",
            "testing": "opened",
            "done": "closed",
            "blocked": "opened"
        }

        gitlab_state = status_mapping.get(new_status.lower(), "opened")
        state_data = {"state_event": gitlab_state}

        try:
            await self.update_issue(issue_id, state_data)
            return True
        except Exception as e:
            logger.error(f"Failed to sync GitLab status: {e}")
