# Webhook handlers for real-time synchronization
class WebhookHandler:
    """Handle webhooks from various platforms"""

    def __init__(self, sync_engine: CrossPlatformSync):
        self.sync_engine = sync_engine
        self.secret = os.getenv('WEBHOOK_SECRET', 'default-secret')

    def verify_signature(self, payload: bytes, signature: str) -> bool:
        """Verify webhook signature"""
        expected_signature = hmac.new(
            self.secret.encode('utf-8'),
            payload,
            hashlib.sha256
        ).hexdigest()
        return hmac.compare_digest(f"sha256={expected_signature}", signature)

    async def handle_github_webhook(self, payload: Dict, signature: str) -> Dict[str, str]:
        """Handle GitHub webhook"""
        if not self.verify_signature(json.dumps(payload).encode(), signature):
            raise ValueError("Invalid GitHub webhook signature")

        action = payload.get('action')
        issue = payload.get('issue')

        if issue and action in ['opened', 'edited', 'closed']:
            # Sync to other platforms
            issue_mapping = IssueMapping(
                platform_id=str(issue['number']),
                platform='github',
                title=issue['title'],
                description=issue['body'] or '',
                status=issue['state'],
                priority='medium',  # Would extract from labels
                labels=[label['name'] for label in issue['labels']],
                assignee=issue['assignee']['login'] if issue.get('assignee') else '',
                created_at=issue['created_at'],
                updated_at=issue['updated_at'],
                url=issue['html_url']
            )

            results = await self.sync_engine.create_issue_across_platforms(issue_mapping)
            return results

        return {"status": "ignored", "reason": "not_issue_event"}

    async def handle_linear_webhook(self, payload: Dict) -> Dict[str, str]:
        """Handle Linear webhook"""
        # Similar implementation for Linear
        action = payload.get('action')
        issue = payload.get('data', {}).get('issue')

        if issue and action in ['create', 'update']:
            # Process Linear webhook and sync to other platforms
            return {"status": "processed"}

        return {"status": "ignored"}

    async def handle_gitlab_webhook(self, payload: Dict) -> Dict[str, str]:
        """Handle GitLab webhook"""
        object_kind = payload.get('object_kind')

        if object_kind == 'issue':
            issue = payload.get('object_attributes', {})
            action = issue.get('action')

            if action in ['open', 'update', 'close']:
                # Process GitLab webhook and sync to other platforms
                return {"status": "processed"}

        return {"status": "ignored"}

# Health check and monitoring
class IntegrationMonitor:
    """Monitor integration health and performance"""

    def __init__(self):
        self.sync_engine = CrossPlatformSync()
        self.health_file = "/tmp/integration_health.json"

    async def health_check(self) -> Dict[str, any]:
        """Perform comprehensive health check"""
        health_status = {
            "timestamp": datetime.now().isoformat(),
            "overall_status": "healthy",
            "platforms": {},
            "last_sync": None,
            "error_count": 0,
            "sync_rate": 0.0
        }

        # Check each platform
        platforms = [
            ("github", self.sync_engine.github),
            ("linear", self.sync_engine.linear),
            ("gitlab", self.sync_engine.gitlab),
            ("bitbucket", self.sync_engine.bitbucket),
            ("jira", self.sync_engine.jira)
        ]

        for platform_name, api in platforms:
            try:
                # Simple connectivity check
                await asyncio.wait_for(api.list_issues({"per_page": 1}), timeout=5)
                health_status["platforms"][platform_name] = {"status": "healthy", "last_check": datetime.now().isoformat()}
            except asyncio.TimeoutError:
                health_status["platforms"][platform_name] = {"status": "timeout", "last_check": datetime.now().isoformat()}
                health_status["overall_status"] = "degraded"
            except Exception as e:
                health_status["platforms"][platform_name] = {"status": "error", "error": str(e), "last_check": datetime.now().isoformat()}
                health_status["overall_status"] = "unhealthy"
                health_status["error_count"] += 1

        # Load last sync information
        if os.path.exists(self.health_file):
            try:
                with open(self.health_file, 'r') as f:
                    last_health = json.load(f)
                    health_status["last_sync"] = last_health.get("last_sync")
                    health_status["sync_rate"] = last_health.get("sync_rate", 0.0)
            except Exception as e:
                logger.warning(f"Could not load health file: {e}")

        # Save current health status
        try:
            with open(self.health_file, 'w') as f:
                json.dump(health_status, f, indent=2)
        except Exception as e:
            logger.warning(f"Could not save health file: {e}")

        return health_status

# Main execution functions
async def main():
    """Main execution function"""
    sync_engine = CrossPlatformSync()

    # Perform comprehensive sync
    stats = await sync_engine.sync_all_platforms()
    print(f"Sync completed: {stats}")

    # Health check
    monitor = IntegrationMonitor()
    health = await monitor.health_check()
    print(f"Health check: {health['overall_status']}")

    return {"sync_stats": stats, "health": health}

