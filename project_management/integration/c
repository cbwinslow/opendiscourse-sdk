                f"{self.base_url}/repositories/{self.workspace}/{self.repo}/issues",
                auth=self.auth,
                params=params
            ) as response:
                if response.status == 200:
                    result = await response.json()
                    return result.get("values", [])
                else:
                    logger.error(f"Failed to list Bitbucket issues: {response.status}")
                    return []

    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        """Sync issue status"""
        # Map generic status to Bitbucket states
        status_mapping = {
            "open": "new",
            "in_progress": "new",
            "in_review": "resolved",
            "testing": "resolved",
            "done": "closed",
            "blocked": "on_hold"
        }

        bb_state = status_mapping.get(new_status.lower(), "new")
        state_data = {"state": bb_state}

        try:
            await self.update_issue(issue_id, state_data)
            return True
        except Exception as e:
            logger.error(f"Failed to sync Bitbucket status: {e}")
            return False

    def _map_kind(self, labels: List[str]) -> str:
        """Map labels to Bitbucket issue kind"""
        if any(label in ["bug", "critical"] for label in labels):
            return "bug"
        elif any(label in ["enhancement", "feature"] for label in labels):
            return "enhancement"
        else:
            return "task"

    def _map_priority(self, priority: str) -> str:
        """Map priority string to Bitbucket priority"""
        mapping = {
            "low": "trivial",
            "medium": "minor",
            "high": "major",
            "critical": "critical"
        }
        return mapping.get(priority.lower(), "minor")

class JiraAPI(PlatformAPI):
    """Jira API implementation"""

    def __init__(self):
        self.url = os.getenv('JIRA_URL')
        self.username = os.getenv('JIRA_USERNAME')
        self.api_token = os.getenv('JIRA_API_TOKEN')
        self.project_key = "OD"
        self.base_url = f"{self.url}/rest/api/3"
        self.auth = aiohttp.BasicAuth(self.username, self.api_token)
        self.headers = {
            "Accept": "application/json",
            "Content-Type": "application/json"
        }

    async def create_issue(self, issue_data: IssueMapping) -> Dict:
        """Create Jira issue"""
        data = {
            "fields": {
                "project": {"key": self.project_key},
                "summary": issue_data.title,
                "description": {
                    "type": "doc",
                    "version": 1,
                    "content": [
                        {
                            "type": "paragraph",
                            "content": [
                                {
                                    "type": "text",
                                    "text": issue_data.description
                                }
                            ]
                        }
                    ]
                },
                "issuetype": {"name": self._map_issue_type(issue_data.labels)},
                "priority": {"name": self._map_priority(issue_data.priority)},
                "assignee": {"accountId": await self._get_assignee_id(issue_data.assignee)}
            }
        }

        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{self.base_url}/issue",
                auth=self.auth,
                headers=self.headers,
                json=data
            ) as response:
                if response.status == 201:
                    result = await response.json()
                    logger.info(f"Created Jira issue: {result['key']}")
                    return result
                else:
                    error_text = await response.text()
                    logger.error(f"Failed to create Jira issue: {error_text}")
                    raise Exception(f"Jira API error: {response.status}")

    async def update_issue(self, issue_id: str, issue_data: Dict) -> Dict:
        """Update Jira issue"""
        async with aiohttp.ClientSession() as session:
            async with session.put(
                f"{self.base_url}/issue/{issue_id}",
                auth=self.auth,
                headers=self.headers,
                json=issue_data
            ) as response:
                if response.status == 204:
                    logger.info(f"Updated Jira issue: {issue_id}")
                    return {"key": issue_id, "updated": True}
                else:
                    error_text = await response.text()
                    logger.error(f"Failed to update Jira issue: {error_text}")
                    raise Exception(f"Jira API error: {response.status}")

    async def get_issue(self, issue_id: str) -> Dict:
        """Get Jira issue"""
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{self.base_url}/issue/{issue_id}",
                auth=self.auth,
                headers=self.headers
            ) as response:
                if response.status == 200:
                    return await response.json()
                else:
                    logger.error(f"Failed to get Jira issue {issue_id}: {response.status}")
                    raise Exception(f"Jira API error: {response.status}")

    async def list_issues(self, filters: Dict = None) -> List[Dict]:
        """List Jira issues"""
        jql = filters.get('jql', f'project = {self.project_key} AND statusCategory != Done')

        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{self.base_url}/search",
                auth=self.auth,
                headers=self.headers,
                params={"jql": jql}
            ) as response:
                if response.status == 200:
                    result = await response.json()
                    return result.get("issues", [])
                else:
                    logger.error(f"Failed to list Jira issues: {response.status}")
                    return []

    async def sync_status(self, issue_id: str, new_status: str) -> bool:
        """Sync issue status"""
        # This would require transitioning the issue through workflow states
        # For simplicity, we'll update the status name field
        status_data = {
            "fields": {
                "status": {"name": self._map_status(new_status)}
            }
        }

        try:
            await self.update_issue(issue_id, status_data)
            return True
        except Exception as e:
            logger.error(f"Failed to sync Jira status: {e}")
            return False

    def _map_issue_type(self, labels: List[str]) -> str:
        """Map labels to Jira issue type"""
        if any(label in ["bug", "critical"] for label in labels):
            return "Bug"
        elif any(label in ["enhancement", "feature"] for label in labels):
            return "Story"
        elif "documentation" in labels:
            return "Task"
        else:
            return "Task"

    def _map_priority(self, priority: str) -> str:
        """Map priority string to Jira priority"""
        mapping = {
            "low": "Low",
            "medium": "Medium",
            "high": "High",
            "critical": "Highest"
        }
        return mapping.get(priority.lower(), "Medium")

    def _map_status(self, status: str) -> str:
        """Map generic status to Jira status"""
        mapping = {
            "open": "To Do",
            "in_progress": "In Progress",
            "in_review": "In Review",
            "testing": "Testing",
            "done": "Done",
            "blocked": "Blocked"
        }
        return mapping.get(status.lower(), "To Do")

    async def _get_assignee_id(self, assignee_name: str) -> Optional[str]:
        """Get Jira user account ID from username"""
        if not assignee_name:
            return None

        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{self.base_url}/user/search?query={assignee_name}",
                auth=self.auth,
                headers=self.headers
            ) as response:
                if response.status == 200:
                    users = await response.json()
                    if users:
                        return users[0]["accountId"]
        return None

class CrossPlatformSync:
    """Main synchronization orchestrator"""

    def __init__(self):
        self.github = GitHubAPI()
        self.linear = LinearAPI()
        self.gitlab = GitLabAPI()
        self.bitbucket = BitbucketAPI()
        self.jira = JiraAPI()

        # Standard status and priority mappings
        self.status_mapping = {
            "open": {"github": "open", "linear": "Backlog", "gitlab": "opened", "bitbucket": "new", "jira": "To Do"},
            "in_progress": {"github": "open", "linear": "In Progress", "gitlab": "opened", "bitbucket": "new", "jira": "In Progress"},
            "in_review": {"github": "open", "linear": "In Review", "gitlab": "opened", "bitbucket": "resolved", "jira": "In Review"},
            "testing": {"github": "open", "linear": "In Review", "gitlab": "opened", "bitbucket": "resolved", "jira": "Testing"},
            "done": {"github": "closed", "linear": "Done", "gitlab": "closed", "bitbucket": "closed", "jira": "Done"},
