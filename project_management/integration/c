        logger.info(f"Syncing status {new_status} for {platform}:{issue_id}")

        results = {}

        if platform not in self.status_mapping:
            logger.error(f"Unknown platform: {platform}")
            return {"success": False}

        status_mapping = self.status_mapping[new_status]

        # Sync to all platforms
        tasks = [
            (self.github.sync_status, issue_id, status_mapping["github"], "github", results),
            (self.linear.sync_status, issue_id, status_mapping["linear"], "linear", results),
            (self.gitlab.sync_status, issue_id, status_mapping["gitlab"], "gitlab", results),
            (self.bitbucket.sync_status, issue_id, status_mapping["bitbucket"], "bitbucket", results),
            (self.jira.sync_status, issue_id, status_mapping["jira"], "jira", results)
        ]

        await asyncio.gather(*[
            self._safe_status_sync(sync_func, issue_id, platform_status, platform_name, results)
            for sync_func, issue_id, platform_status, platform_name, results in tasks
        ])

        return results

    async def sync_all_platforms(self) -> Dict[str, int]:
        """Synchronize all platforms - fetch, compare, and sync differences"""
        logger.info("Starting comprehensive platform synchronization")

        sync_stats = {"synced": 0, "created": 0, "updated": 0, "errors": 0}

        try:
            # Collect issues from all platforms
            all_issues = await self._collect_all_issues()

            # Identify conflicts and synchronization needs
            sync_actions = await self._identify_sync_actions(all_issues)

            # Execute synchronization actions
            for action in sync_actions:
                try:
                    if action["type"] == "create":
                        result = await self.create_issue_across_platforms(action["data"])
                        sync_stats["created"] += len(result["successful"])
                    elif action["type"] == "update":
                        result = await self._update_issue_sync(action["platform"], action["issue_id"], action["data"])
                        sync_stats["updated"] += 1

                    sync_stats["synced"] += 1

                except Exception as e:
                    logger.error(f"Sync action failed: {e}")
                    sync_stats["errors"] += 1

        except Exception as e:
            logger.error(f"Comprehensive sync failed: {e}")
            sync_stats["errors"] += 1

        logger.info(f"Sync completed. Stats: {sync_stats}")
        return sync_stats

    async def _safe_execute(self, func, *args, platform_key, results, errors):
