    async def create_issue_across_platforms(self, issue_data: IssueMapping) -> Dict[str, str]:
        """Create issue across all platforms"""
        logger.info(f"Creating issue across platforms: {issue_data.title}")

        results = {}
        errors = {}

        # Create on all platforms concurrently
        tasks = [
            (self.github.create_issue, issue_data, "github", results, errors),
            (self.linear.create_issue, issue_data, "linear", results, errors),
            (self.gitlab.create_issue, issue_data, "gitlab", results, errors),
            (self.bitbucket.create_issue, issue_data, "bitbucket", results, errors),
            (self.jira.create_issue, issue_data, "jira", results, errors)
        ]

        await asyncio.gather(*[
            self._safe_execute(create_func, issue_data, platform, results, errors)
            for create_func, issue_data, platform, results, errors in tasks
        ])

        logger.info(f"Issue creation completed. Success: {len(results)}, Errors: {len(errors)}")
        return {"successful": results, "failed": errors}

    async def sync_issue_status(self, platform: str, issue_id: str, new_status: str) -> Dict[str, bool]:
