# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opendiscourse
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative Database Configuration (for compatibility)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opendiscourse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# API Keys for Data Sources
CONGRESS_API_KEY=your_congress_api_key_here
GOVINFO_API_KEY=your_govinfo_api_key_here
OPENSTATES_API_KEY=your_openstates_api_key_here

# Supabase Configuration (optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# VectorDB Configuration
VECTORDB_API_KEY=your_pinecone_api_key_here
VECTORDB_ENVIRONMENT=your_pinecone_environment_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Logging Configuration
LOG_LEVEL=INFO

# Document Processing Configuration
DOWNLOAD_DIR=/path/to/download/directory
PROCESSING_DIR=/path/to/processing/directory
COMPLETED_DIR=/path/to/completed/directory
ERROR_DIR=/path/to/error/directory

# Ingestion Configuration
INGESTION_MODE=production
BATCH_SIZE=50
MAX_RETRIES=3
RATE_LIMIT_DELAY=0.5
