# OpenDiscourse Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false) - Set to false in production
DEBUG=true

# Application name and version
APP_NAME=OpenDiscourse
APP_VERSION=1.0.1

# Secret key for cryptographic operations (generate a secure random string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Host and port configuration
HOST=0.0.0.0
PORT=8000

# API base URL
API_BASE_URL=http://localhost:8000

# CORS settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/application.log

# Enable structured logging (true/false)
STRUCTURED_LOGGING=true

# Log rotation settings
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Primary database URL (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/opendiscourse

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Database echo mode (true/false) - Set to false in production
DB_ECHO=false

# Test database URL (for running tests)
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/opendiscourse_test

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================

# ChromaDB settings
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Vector similarity threshold (0.0 to 1.0)
VECTOR_SIMILARITY_THRESHOLD=0.7

# Embedding model settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching)
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=30

# Cache TTL settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SEARCH_RESULTS=1800
CACHE_TTL_DOCUMENT_METADATA=7200

# =============================================================================
# AI/ML API KEYS AND CONFIGURATION
# =============================================================================

# OpenAI API configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# NVIDIA NIM API configuration
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://api.nvcf.nvidia.com/v2/nvcf
NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Anthropic Claude API (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Hugging Face API (optional)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# =============================================================================
# GOVERNMENT DATA API CONFIGURATION
# =============================================================================

# GovInfo API settings
GOVINFO_API_KEY=your-govinfo-api-key-here
GOVINFO_BASE_URL=https://api.govinfo.gov

# Congress API settings
CONGRESS_API_KEY=your-congress-api-key-here
CONGRESS_BASE_URL=https://api.congress.gov/v3

# Federal Register API settings
FEDERAL_REGISTER_API_KEY=your-federal-register-api-key-here
FEDERAL_REGISTER_BASE_URL=https://www.federalregister.gov/api/v1

# Data refresh intervals (in hours)
GOVDATA_REFRESH_INTERVAL=24
GOVDATA_BATCH_SIZE=100
GOVDATA_MAX_RETRIES=3

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# Local file storage paths
UPLOAD_DIRECTORY=data/uploads
PROCESSED_DIRECTORY=data/processed
EXPORT_DIRECTORY=data/exports
TEMP_DIRECTORY=temp

# File size limits (in bytes)
MAX_FILE_SIZE=100MB
MAX_TOTAL_FILES=1000

# Supported file formats (comma-separated)
SUPPORTED_FORMATS=pdf,doc,docx,txt,html,xml,rtf

# File retention policy (in days)
FILE_RETENTION_DAYS=365
TEMP_FILE_RETENTION_HOURS=24

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authentication settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=200

# CORS settings
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Security headers
SECURITY_HSTS_ENABLED=true
SECURITY_CSRF_ENABLED=true
SECURITY_CONTENT_TYPE_NOSNIFF=true

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Document processing settings
PROCESSING_WORKERS=4
PROCESSING_TIMEOUT=300
PROCESSING_QUEUE_SIZE=1000

# RAG processing settings
RAG_CONTEXT_LENGTH=4000
RAG_MAX_SOURCES=10
RAG_STREAMING_ENABLED=true

# Entity extraction settings
ENTITY_EXTRACTION_ENABLED=true
ENTITY_CONFIDENCE_THRESHOLD=0.8
ENTITY_EXTRACTION_MODELS=en_core_web_sm

# Batch processing settings
BATCH_SIZE=50
BATCH_TIMEOUT=600
BATCH_MAX_RETRIES=3

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_TIMEOUT=30

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Performance monitoring
PERFORMANCE_MONITORING=true
SLOW_QUERY_THRESHOLD=1000
MEMORY_THRESHOLD_MB=1000

# Error tracking (Sentry integration)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Webhook configuration
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

# Email notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true

# Slack integration (optional)
SLACK_WEBHOOK_URL=your-slack-webhook-url-here
SLACK_CHANNEL=#opendiscourse-alerts

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode flags
DEV_RELOAD=true
DEV_MOCK_APIS=false
DEV_SKIP_AUTH=false

# Testing configuration
TESTING_ENABLED=true
TEST_COVERAGE_THRESHOLD=80
TEST_PARALLEL_WORKERS=auto

# Debug tools
PROFILING_ENABLED=false
SQL_QUERY_LOGGING=false
REQUEST_LOGGING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core features
FEATURE_DOCUMENT_UPLOAD=true
FEATURE_SEMANTIC_SEARCH=true
FEATURE_RAG_QUERIES=true
FEATURE_ENTITY_EXTRACTION=true

# Advanced features
FEATURE_GOVERNMENT_DATA=true
FEATURE_BATCH_PROCESSING=true
FEATURE_REAL_TIME_SEARCH=true
FEATURE_ANALYTICS_DASHBOARD=true

# Experimental features
FEATURE_AI_SUMMARIZATION=false
FEATURE_KNOWLEDGE_GRAPH=false
FEATURE_MULTI_LANGUAGE=false

# =============================================================================
# SCALING AND PERFORMANCE
# =============================================================================

# Worker configuration
WORKER_PROCESSES=4
WORKER_THREADS_PER_PROCESS=2
WORKER_MAX_REQUESTS=1000
WORKER_MAX_REQUESTS_JITTER=100

# Caching configuration
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_KEY_PREFIX=opendiscourse
CACHE_SERIALIZER=json

# Database optimization
DB_QUERY_CACHE_SIZE=1000
DB_CONNECTION_LIFETIME=3600
DB_STATEMENT_TIMEOUT=30000

# Memory management
MEMORY_LIMIT_MB=2048
GARBAGE_COLLECTION_THRESHOLD=1000

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================

# Backup configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Recovery settings
RECOVERY_ENABLED=true
RECOVERY_POINT_INTERVAL=3600  # 1 hour
RECOVERY_TIMEOUT=1800  # 30 minutes

# =============================================================================
# COMPLIANCE AND AUDITING
# =============================================================================

# Audit logging
AUDIT_LOGGING=true
AUDIT_LOG_FILE=logs/audit.log
AUDIT_RETENTION_DAYS=365

# Data retention
DATA_RETENTION_POLICY=true
PERSONAL_DATA_RETENTION_DAYS=730
SYSTEM_LOG_RETENTION_DAYS=90

# Privacy settings
PRIVACY_MODE=false
ANONYMIZE_USER_DATA=false
GDPR_COMPLIANCE=true

# =============================================================================
# CUSTOM EXTENSIONS
# =============================================================================

# Plugin system
PLUGINS_ENABLED=true
PLUGINS_DIRECTORY=plugins
PLUGINS_AUTO_LOAD=false

# Custom models
CUSTOM_MODELS_DIRECTORY=models
CUSTOM_MODELS_ENABLED=false

# Integration hooks
PRE_PROCESSING_HOOKS=
POST_PROCESSING_HOOKS=
NOTIFICATION_HOOKS=

# =============================================================================
# NOTES
# =============================================================================

# 1. Always use strong, unique passwords and API keys
# 2. Set DEBUG=false in production environments
# 3. Use environment-specific configuration files
# 4. Store sensitive data in secure vaults (not in this file)
# 5. Regularly rotate API keys and secrets
# 6. Monitor resource usage and adjust limits accordingly
# 7. Enable comprehensive logging in production
# 8. Test configuration changes in staging before production
# 9. Document any custom configuration options
# 10. Keep this template updated with new configuration options

