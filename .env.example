# Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=development
DEBUG=false

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=opendiscourse
DATABASE__USER=your_username
DATABASE__PASSWORD=your_password_here

# Connection Pooling
DATABASE__MIN_CONNECTIONS=1
DATABASE__MAX_CONNECTIONS=10

# Timeouts (seconds)
DATABASE__CONNECTION_TIMEOUT=30
DATABASE__COMMAND_TIMEOUT=300

# SSL Mode (disable, allow, prefer, require, verify-ca, verify-full)
DATABASE__SSL_MODE=prefer

# ============================================================================
# Congress.gov API
# ============================================================================
CONGRESS_API__API_KEY=your_congress_api_key_here
CONGRESS_API__BASE_URL=https://api.congress.gov/v3
CONGRESS_API__RATE_LIMIT=100
CONGRESS_API__MAX_RETRIES=3
CONGRESS_API__TIMEOUT=30

# ============================================================================
# OpenStates API
# ============================================================================
OPENSTATES_API__API_KEY=your_openstates_api_key_here
OPENSTATES_API__BASE_URL=https://v3.openstates.org
OPENSTATES_API__RATE_LIMIT=20
OPENSTATES_API__GRAPH_URL=https://v3.openstates.org/graphql

# ============================================================================
# GovInfo API
# ============================================================================
GOVINFO_API__API_KEY=your_govinfo_api_key_here
GOVINFO_API__BASE_URL=https://api.govinfo.gov
GOVINFO_API__RATE_LIMIT=50

# ============================================================================
# Ingestion Configuration
# ============================================================================
INGESTION__BATCH_SIZE=50
INGESTION__PARALLEL_WORKERS=4
INGESTION__MAX_RETRIES=3
INGESTION__CHECKPOINT_INTERVAL=100

# ============================================================================
# Export Configuration
# ============================================================================
EXPORT__DEFAULT_FORMAT=json
EXPORT__COMPRESSION=none
EXPORT__OUTPUT_DIR=./exports
EXPORT__INCLUDE_METADATA=true

# ============================================================================
# Logging Configuration
# ============================================================================
LOGGING__LEVEL=INFO
LOGGING__FILE=./logs/opendiscourse.log
LOGGING__MAX_BYTES=10000000
LOGGING__BACKUP_COUNT=5
LOGGING__JSON_LOGS=false

# ============================================================================
# Paths
# ============================================================================
MIGRATIONS_DIR=./migrations
DATA_DIR=./data
