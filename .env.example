# OpenDiscourse Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION - MANDATORY SETTINGS
# ============================================================================

# PostgreSQL Database Connection - ALWAYS USE THESE EXACT VALUES
DB_NAME=opendiscourse
DB_USER=cbwinslow
DB_HOST=/var/run/postgresql
DB_PORT=5432

# Database Connection String (for applications that need it)
DATABASE_URL=postgresql://cbwinslow@/var/run/postgresql/opendiscourse

# ============================================================================
# API KEYS - REQUIRED FOR DATA INGESTION
# ============================================================================

# Congress.gov API Key
# Get from: https://api.congress.gov/
# Required for: Congress members and bills ingestion
CONGRESS_API_KEY=your_congress_api_key_here

# OpenStates API Key
# Get from: https://openstates.org/api
# Required for: State legislators ingestion
OPENSTATES_API_KEY=your_openstates_api_key_here

# GovInfo API Key
# Get from: https://www.govinfo.gov/api
# Required for: Federal documents ingestion (planned)
GOVINFO_API_KEY=your_govinfo_api_key_here

# ============================================================================
# OPENAI API - FOR RAG AND VECTOR SEARCH
# ============================================================================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Required for: Document embeddings, RAG queries
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application Environment
ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application Host/Port
HOST=0.0.0.0
PORT=8000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Secret Key for sessions and tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# API Key Header Name
API_KEY_HEADER=X-API-Key

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# API Rate Limits (requests per minute)
CONGRESS_API_RATE_LIMIT=120
OPENSTATES_API_RATE_LIMIT=100
GOVINFO_API_RATE_LIMIT=1000

# ============================================================================
# BATCH PROCESSING CONFIGURATION
# ============================================================================

# Default batch sizes for data ingestion
DEFAULT_BATCH_SIZE=50
CONGRESS_BATCH_SIZE=50
OPENSTATES_BATCH_SIZE=100

# Rate limiting delays (seconds between API calls)
CONGRESS_API_DELAY=0.1
OPENSTATES_API_DELAY=0.6
GOVINFO_API_DELAY=0.2

# ============================================================================
# VECTOR DATABASE CONFIGURATION (PGVector)
# ============================================================================

# PGVector Configuration
VECTOR_DB_ENABLED=true
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=ivfflat

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Enable monitoring and metrics
MONITORING_ENABLED=false

# Metrics Port
METRICS_PORT=9090

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Enable debug mode
DEBUG=false

# Enable test mode
TEST_MODE=false

# Dry run mode (no database writes)
DRY_RUN=false

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup directory
BACKUP_DIR=/home/cbwinslow/Videos/opendiscourse/backups

# Automatic backup enabled
AUTO_BACKUP_ENABLED=false

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ============================================================================
# CRITICAL NOTES - READ THESE
# ============================================================================

# 1. NEVER commit actual API keys to version control
# 2. ALWAYS use real API keys (never demo/placeholder keys)
# 3. Database connection parameters MUST match the values above
# 4. Keep this file secure and do not share it publicly
# 5. Use Unix socket /var/run/postgresql for reliable connections
# 6. NEVER use localhost for database connections

# ============================================================================
# VALIDATION COMMANDS
# ============================================================================

# Test your configuration with:
# python -c "
# import os
# from dotenv import load_dotenv
# load_dotenv()
# required_vars = ['CONGRESS_API_KEY', 'OPENSTATES_API_KEY', 'DB_NAME']
# missing = [var for var in required_vars if not os.getenv(var)]
# if missing:
#     print(f'Missing required environment variables: {missing}')
# else:
#     print('All required environment variables are set')
# "
DB_PORT=5432

# Example environment variables
# DATABASE_URL=postgresql://user:pass@localhost:5432/opendiscourse

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here

# External Services
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Web Scraping
USER_AGENT=OpenDiscourse/1.0
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Performance
BATCH_SIZE=100
MAX_WORKERS=4
CACHE_TTL=3600
